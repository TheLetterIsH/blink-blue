[sub_resource type="Shader" id="Shader_stmte"]
code = "shader_type canvas_item;

// Normalized direction along which the sprite squashes.
// Vector2(0,0) means \"no deformation\".
uniform vec2 direction = vec2(0.0, 0.0);

// 0 = no deformation, 1 = max deformation.
uniform float strength : hint_range(0.0, 1.0) = 0.0;

// How much scale_parallel/perpendicular shift per unit of strength.
// Clamped so scale_parallel can never hit 0 or go negative.
uniform float squash_amount : hint_range(0.0, 0.99) = 0.5;

void vertex() {
	float dirLen = length(direction);
	
	if (dirLen > 0.0001 && strength > 0.0001) {
		vec2 dir = direction / dirLen; // normalize, but avoids NaN on zero vec
		vec2 perp = vec2(-dir.y, dir.x);
		
		float dot_parallel = dot(VERTEX.xy, dir);
		float dot_perpendicular = dot(VERTEX.xy, perp);
		
		// Symmetric, linked scaling — same as your original, but bounded.
		float amount = clamp(squash_amount * strength, 0.0, 0.99);
		float scale_parallel = 1.0 - amount;
		float scale_perpendicular = 1.0 + amount;
		
		VERTEX.xy = dot_parallel * dir * scale_parallel + dot_perpendicular * perp * scale_perpendicular;
    }
}"

